{
  "manifest_version": 3,
  "name": "تجربه کاری شرکت‌ها",
  "version": "1.0.0",
  "description": "مشاهده تجربه‌های کاری شرکت‌ها از tajrobe.github.io هنگام بازدید از جاب‌ویژن و جابینجا",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://tajrobe.github.io/*",
    "https://jobvision.ir/*",
    "https://www.jobvision.ir/*",
    "https://jobinja.ir/*",
    "https://www.jobinja.ir/*",
    "https://api.linka.ir/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobvision.ir/companies/*",
        "https://www.jobvision.ir/companies/*",
        "https://jobinja.ir/companies/*",
        "https://www.jobinja.ir/companies/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
